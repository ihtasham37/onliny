# Cloudflare Pages Global Security and Caching Rules

# Global headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=()

# Immutable caching for static assets generated by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure PWA service worker and manifest are never cached stale
/service-worker.js
  Cache-Control: public, max-age=0, no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/sw.js
  Cache-Control: public, max-age=0, no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# Static icons and sitemaps
/favicon.svg
  Cache-Control: public, max-age=86400

/pwa-*.png
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
