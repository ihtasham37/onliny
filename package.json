    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "firebase": "^10.12.2",
    "html2pdf.js": "^0.14.0",
    "motion": "^12.42.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
